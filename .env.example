# ============================================================================
# LINA MANUFACTURING · PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================

# Network & Server Port
PORT=5173
HOST=0.0.0.0

# Environment Mode (production / development)
NODE_ENV=production

# Session & Authentication Secret (Generate high-entropy random string for production)
SESSION_SECRET=your_production_session_secret_key_here

# Supabase Production Credentials (Do NOT commit real keys to git)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Persistent Storage Path (Default: data/stock_count.db)
DATABASE_FILE=data/stock_count.db

# Allowed CORS Origins (Comma-separated for multi-domain deployments)
ALLOWED_ORIGINS=http://localhost:5173,https://stock.linamanufacturing.com
